+#pragma mark - Custom Background
+
+// Call this once from the main thread. It stores the size the background is
+// rendered at, so background work never has to query UIScreen off the main thread.
+- (void)prepareScreenMetrics
+{
+    CGFloat screenScale = [UIScreen mainScreen].scale;
+    if (screenScale <= 0) {
+        screenScale = 2.0;
+    }
+    CGSize screenSize = [UIScreen mainScreen].bounds.size;
+    CGFloat maxDimension = MAX(screenSize.width, screenSize.height) * screenScale * 1.2;
+    gRenderMaxDimension = MAX(maxDimension, 1024.0);
+}
+
+- (NSString *)customBackgroundPath
+{
+    NSString *documentsPath = [NSHomeDirectory() stringByAppendingPathComponent:@"Documents"];
+    return [documentsPath stringByAppendingPathComponent:CUSTOM_BACKGROUND_FILE_NAME];
+}
+
+- (NSString *)renderedBackgroundPath
+{
+    NSString *documentsPath = [NSHomeDirectory() stringByAppendingPathComponent:@"Documents"];
+    return [documentsPath stringByAppendingPathComponent:CUSTOM_BACKGROUND_RENDERED_FILE_NAME];
+}
+
+- (BOOL)hasCustomBackground
+{
+    return [[NSFileManager defaultManager] fileExistsAtPath:[self customBackgroundPath]];
+}
+
+- (nullable UIImage *)customBackgroundImage
+{
+    @synchronized (self) {
+        if (gCustomBackgroundRaw) {
+            return gCustomBackgroundRaw;
+        }
+        if (![self hasCustomBackground]) {
+            return nil;
+        }
+        UIImage *image = [UIImage imageWithContentsOfFile:[self customBackgroundPath]];
+        gCustomBackgroundRaw = image;
+        return image;
+    }
+}
+
+- (UIImage *)currentBackgroundImage
+{
+    UIImage *customImage = [self customBackgroundImage];
+    if (customImage) {
+        @synchronized (self) {
+            if (gCustomBackgroundRendered) {
+                return gCustomBackgroundRendered;
+            }
+        }
+
+        // The blurred version is cached on disk so app launches do not have to
+        // run the blur again on the main thread
+        UIImage *cachedImage = [UIImage imageWithContentsOfFile:[self renderedBackgroundPath]];
+        if (!cachedImage) {
+            // Old install / missing cache, render now and write the cache
+            cachedImage = [self renderBackgroundFromImage:customImage] ?: customImage;
+            NSData *renderedData = UIImageJPEGRepresentation(cachedImage, 0.9);
+            if (renderedData) {
+                [renderedData writeToFile:[self renderedBackgroundPath] atomically:YES];
+            }
+        }
+
+        @synchronized (self) {
+            gCustomBackgroundRendered = cachedImage;
+            return gCustomBackgroundRendered ?: customImage;
+        }
+    }
+    return [[self enabledTheme] image];
+}
+
+- (BOOL)setCustomBackgroundImage:(UIImage *)image error:(NSError * _Nullable * _Nullable)error
+{
+    if (!image) {
+        if (error) *error = [self errorWithDescription:@"No image was provided"];
+        return NO;
+    }
+
+    UIImage *preparedImage = [self normalizedImage:image maxDimension:CUSTOM_BACKGROUND_MAX_DIMENSION];
+    NSData *jpegData = UIImageJPEGRepresentation(preparedImage, 0.92);
+    if (!jpegData) {
+        if (error) *error = [self errorWithDescription:@"Failed to encode the selected image"];
+        return NO;
+    }
+
+    NSString *path = [self customBackgroundPath];
+    if (![[NSFileManager defaultManager] createDirectoryAtPath:[path stringByDeletingLastPathComponent] withIntermediateDirectories:YES attributes:nil error:error]) {
+        return NO;
+    }
+
+    if (![jpegData writeToFile:path atomically:YES]) {
+        if (error) *error = [self errorWithDescription:@"Failed to write the selected image to disk"];
+        return NO;
+    }
+
+    @synchronized (self) {
+        gCustomBackgroundRaw = preparedImage;
+        // Pre-render here so the (expensive) blur does not have to happen on the main thread
+        gCustomBackgroundRendered = [self renderBackgroundFromImage:preparedImage] ?: preparedImage;
+    }
+
+    NSData *renderedData = UIImageJPEGRepresentation(gCustomBackgroundRendered, 0.9);
+    if (renderedData) {
+        [renderedData writeToFile:[self renderedBackgroundPath] atomically:YES];
+    }
+
+    return YES;
+}
+
+- (BOOL)removeCustomBackgroundWithError:(NSError * _Nullable * _Nullable)error
+{
+    NSString *path = [self customBackgroundPath];
+    @synchronized (self) {
+        gCustomBackgroundRaw = nil;
+        gCustomBackgroundRendered = nil;
+    }
+
+    [[NSFileManager defaultManager] removeItemAtPath:[self renderedBackgroundPath] error:nil];
+
+    if (![[NSFileManager defaultManager] fileExistsAtPath:path]) {
+        return YES;
+    }
+
+    return [[NSFileManager defaultManager] removeItemAtPath:path error:error];
+}
+
+#pragma mark - Custom Background Helpers
+
+- (CGFloat)customBackgroundBlurRadius
+{
+    CGFloat radius = [self enabledTheme].blur;
+    return MAX(radius, CUSTOM_BACKGROUND_DEFAULT_BLUR);
+}
+
+- (UIImage *)normalizedImage:(UIImage *)image maxDimension:(CGFloat)maxDimension
+{
+    CGFloat pixelWidth = image.size.width * image.scale;
+    CGFloat pixelHeight = image.size.height * image.scale;
+    if (pixelWidth <= 0 || pixelHeight <= 0) {
+        return image;
+    }
+
+    CGFloat factor = MIN(1.0, maxDimension / MAX(pixelWidth, pixelHeight));
+    CGSize targetSize = CGSizeMake(floor(pixelWidth * factor), floor(pixelHeight * factor));
+    if (targetSize.width < 1 || targetSize.height < 1) {
+        return image;
+    }
+
+    // Redrawing also normalizes the image orientation of photos coming from the camera roll
+    UIGraphicsBeginImageContextWithOptions(targetSize, NO, 1.0);
+    [image drawInRect:CGRectMake(0, 0, targetSize.width, targetSize.height)];
+    UIImage *normalizedImage = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+
+    return normalizedImage ?: image;
+}
+
+- (UIImage *)renderBackgroundFromImage:(UIImage *)image
+{
+    if (!image.CGImage) {
+        return image;
+    }
+
+    // The background is blurred anyway, so work on a screen sized copy. Blurring a
+    // 2000x2000 image costs a lot of time and memory for no visual benefit.
+    CGFloat renderMaxDimension = gRenderMaxDimension;
+    if (renderMaxDimension <= 0) {
+        // Fallback for the (unexpected) case where prepareScreenMetrics was not called
+        CGFloat screenScale = [UIScreen mainScreen].scale > 0 ? [UIScreen mainScreen].scale : 2.0;
+        CGSize screenSize = [UIScreen mainScreen].bounds.size;
+        renderMaxDimension = MAX(MAX(screenSize.width, screenSize.height) * screenScale * 1.2, 1024.0);
+    }
+    UIImage *workingImage = [self normalizedImage:image maxDimension:renderMaxDimension];
+
+    UIImage *blurredImage = [self blurredImage:workingImage radius:[self customBackgroundBlurRadius]];
+    if (!blurredImage) {
+        blurredImage = workingImage;
+    }
+
+    // Dim the image a little so the white UI stays readable on bright photos
+    CGSize size = blurredImage.size;
+    if (size.width < 1 || size.height < 1) {
+        return blurredImage;
+    }
+
+    UIGraphicsBeginImageContextWithOptions(size, NO, 1.0);
+    [blurredImage drawInRect:CGRectMake(0, 0, size.width, size.height)];
+    [[UIColor colorWithWhite:0.0 alpha:CUSTOM_BACKGROUND_DIM_ALPHA] setFill];
+    UIRectFill(CGRectMake(0, 0, size.width, size.height));
+    UIImage *renderedImage = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+
+    return renderedImage ?: blurredImage;
+}
+
+// Safe gaussian blur: never throws, never returns a nil image. The shared
+// -[UIImage imageWithBlur:] crashes when CIContext fails to create a CGImage.
+- (nullable UIImage *)blurredImage:(UIImage *)image radius:(CGFloat)radius
+{
+    CGImageRef cgImage = image.CGImage;
+    if (!cgImage) {
+        return image;
+    }
+
+    @try {
+        CIImage *inputImage = [CIImage imageWithCGImage:cgImage];
+        if (!inputImage) {
+            return image;
+        }
+
+        CIFilter *filter = [CIFilter filterWithName:@"CIGaussianBlur"];
+        if (!filter) {
+            return image;
+        }
+        [filter setDefaults];
+        [filter setValue:[inputImage imageByClampingToExtent] forKey:kCIInputImageKey];
+        [filter setValue:@(radius) forKey:kCIInputRadiusKey];
+
+        CIImage *outputImage = [filter outputImage];
+        if (!outputImage) {
+            return image;
+        }
+        outputImage = [outputImage imageByCroppingToRect:[inputImage extent]];
+
+        static CIContext *context = nil;
+        static dispatch_once_t onceToken;
+        dispatch_once(&onceToken, ^{
+            context = [CIContext contextWithOptions:nil];
+        });
+
+        CGImageRef outputCGImage = [context createCGImage:outputImage fromRect:[inputImage extent]];
+        if (!outputCGImage) {
+            return image;
+        }
+
+        UIImage *result = [UIImage imageWithCGImage:outputCGImage scale:image.scale orientation:image.imageOrientation];
+        CGImageRelease(outputCGImage);
+        return result ?: image;
+    } @catch (NSException *exception) {
+        return image;
+    }
