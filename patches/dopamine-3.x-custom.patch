+- (NSString *)systemVersionStatusString
+{
+    UIDevice *device = [UIDevice currentDevice];
+    NSString *systemVersion = [NSString stringWithFormat:@"%@ %@", device.systemName, device.systemVersion];
+    return [NSString stringWithFormat:DOLocalizedString(@"Home_System_Version"), systemVersion];
