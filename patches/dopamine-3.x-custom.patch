+
+// Compares two Debian version strings ([epoch:]upstream[-revision]),
+// returns NSOrderedAscending when versionA is older than versionB
+static NSComparisonResult DOCompareVersionStrings(NSString *versionA, NSString *versionB)
+{
+    NSArray<NSString *> *(^components)(NSString *) = ^NSArray<NSString *> *(NSString *version) {
+        NSRange epochRange = [version rangeOfString:@":"];
+        if (epochRange.location != NSNotFound) {
+            version = [version substringFromIndex:epochRange.location + 1];
+        }
+        NSRange revisionRange = [version rangeOfString:@"-" options:NSBackwardsSearch];
+        if (revisionRange.location != NSNotFound) {
+            version = [version substringToIndex:revisionRange.location];
+        }
+        return [version componentsSeparatedByString:@"."];
+    };
+
+    NSArray<NSString *> *componentsA = components(versionA);
+    NSArray<NSString *> *componentsB = components(versionB);
+
+    NSUInteger count = MAX(componentsA.count, componentsB.count);
+    for (NSUInteger i = 0; i < count; i++) {
+        NSInteger valueA = i < componentsA.count ? componentsA[i].integerValue : 0;
+        NSInteger valueB = i < componentsB.count ? componentsB[i].integerValue : 0;
+        if (valueA < valueB) return NSOrderedAscending;
+        if (valueA > valueB) return NSOrderedDescending;
+    }
+    return NSOrderedSame;
+}
