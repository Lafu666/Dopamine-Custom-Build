+- (void)refreshStatusInfo
+{
+    self.versionStatusLabel.text = [self versionStatusString];
+    [self refreshUptimeStatus];
+}
+
+- (NSString *)versionStatusString
+{
+    NSString *version = [[DOEnvironmentManager sharedManager] appVersionDisplayString];
+    NSDate *buildDate = [self buildDate];
+    if (!buildDate) {
+        return [NSString stringWithFormat:DOLocalizedString(@"Home_Version_Only"), version];
+    }
+
+    static NSDateFormatter *dateFormatter = nil;
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        dateFormatter = [[NSDateFormatter alloc] init];
+        dateFormatter.dateStyle = NSDateFormatterShortStyle;
+        dateFormatter.timeStyle = NSDateFormatterShortStyle;
+    });
+
+    return [NSString stringWithFormat:DOLocalizedString(@"Home_Version_Updated"), version, [dateFormatter stringFromDate:buildDate]];
+}
+
+- (NSDate *)buildDate
+{
+    // Modification date of the binary corresponds to the time this build was installed / updated
+    NSString *executablePath = [[NSBundle mainBundle] executablePath];
+    if (!executablePath) {
+        return nil;
+    }
+    NSDictionary<NSFileAttributeKey, id> *attributes = [[NSFileManager defaultManager] attributesOfItemAtPath:executablePath error:nil];
+    return attributes[NSFileModificationDate];
+}
+
+- (void)refreshUptimeStatus
+{
+    NSDateComponentsFormatter *formatter = [[NSDateComponentsFormatter alloc] init];
+    formatter.unitsStyle = NSDateComponentsFormatterUnitsStyleFull;
+    formatter.allowedUnits = NSCalendarUnitDay | NSCalendarUnitHour | NSCalendarUnitMinute;
+    formatter.maximumUnitCount = 2;
+    formatter.zeroFormattingBehavior = NSDateComponentsFormatterZeroFormattingBehaviorDropAll;
+
+    NSString *uptimeString = [formatter stringFromTimeInterval:[self systemUptime]];
+    if (!uptimeString) {
+        uptimeString = @"-";
+    }
+
+    self.uptimeStatusLabel.text = [NSString stringWithFormat:DOLocalizedString(@"Home_Uptime"), uptimeString];
+}
+
+- (NSTimeInterval)systemUptime
+{
+    struct timeval bootTime;
+    size_t bootTimeSize = sizeof(bootTime);
+    int mib[2] = {CTL_KERN, KERN_BOOTTIME};
+    if (sysctl(mib, 2, &bootTime, &bootTimeSize, NULL, 0) == 0 && bootTime.tv_sec > 0) {
+        return difftime(time(NULL), bootTime.tv_sec);
+    }
+    return [[NSProcessInfo processInfo] systemUptime];
+}
+
+- (void)startUptimeTimer
+{
+    [self stopUptimeTimer];
+
+    __weak typeof(self) weakSelf = self;
+    self.uptimeTimer = [NSTimer scheduledTimerWithTimeInterval:30.0 repeats:YES block:^(NSTimer * _Nonnull timer) {
+        [weakSelf refreshUptimeStatus];
+    }];
+    [[NSRunLoop mainRunLoop] addTimer:self.uptimeTimer forMode:NSRunLoopCommonModes];
+}
+
+- (void)stopUptimeTimer
+{
+    [self.uptimeTimer invalidate];
+    self.uptimeTimer = nil;
 }
 
