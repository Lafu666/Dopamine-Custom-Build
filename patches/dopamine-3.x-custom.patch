+    label.textColor = [UIColor colorWithWhite:1.0 alpha:0.42];
+    label.textAlignment = NSTextAlignmentCenter;
+    label.adjustsFontSizeToFitWidth = YES;
+    label.minimumScaleFactor = 0.75;
+    label.userInteractionEnabled = NO;
+    return label;
