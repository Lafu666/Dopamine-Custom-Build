+// Called when respring / reboot userspace did not actually bring us down.
+// Restores the UI instead of leaving the app on a black screen.
+- (void)restoreFromFade
+{
+    UIView *mainView = self.parentViewController.view;
+    if (!mainView) {
+        return;
+    }
+
+    BOOL isFaded = (mainView.alpha < 0.99) || !CGAffineTransformEqualToTransform(mainView.transform, CGAffineTransformIdentity);
+    if (!isFaded) {
+        return;
+    }
+
+    self.didFade = NO;
+    self.hideStatusBar = NO;
+
+    [UIView animateWithDuration:0.35 animations:^{
+        mainView.transform = CGAffineTransformIdentity;
+        mainView.alpha = 1.0;
+    }];
+}
