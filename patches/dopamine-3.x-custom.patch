diff --git a/Application/Dopamine/UI/Themes/DOThemeManager.m b/Application/Dopamine/UI/Themes/DOThemeManager.m
index 1b38976..7f06c48 100644
--- a/Application/Dopamine/UI/Themes/DOThemeManager.m
+++ b/Application/Dopamine/UI/Themes/DOThemeManager.m
@@ -7,6 +7,18 @@
 
 #import "DOThemeManager.h"
 #import "DOPreferenceManager.h"
+#import "UIImage+Blur.h"
+
+#define CUSTOM_BACKGROUND_FILE_NAME         @"custom_theme_background.jpg"
+#define CUSTOM_BACKGROUND_MAX_DIMENSION     2000.0
+#define CUSTOM_BACKGROUND_DEFAULT_BLUR      18.0
+#define CUSTOM_BACKGROUND_DIM_ALPHA         0.22
+#define CUSTOM_BACKGROUND_ERROR_DOMAIN      @"DOThemeManagerErrorDomain"
+
+// Rendered (blurred / dimmed) and raw version of the custom background are cached
+// so the blur only has to be calculated when the image is changed or the app is launched
+static UIImage *gCustomBackgroundRaw = nil;
+static UIImage *gCustomBackgroundRendered = nil;
 
 @implementation DOThemeManager
 
@@ -85,5 +97,149 @@
     return [UIColor colorWithRed:red green:green blue:blue alpha:currentAlpha * alpha];
 }
 
+#pragma mark - Custom Background
+
+- (NSString *)customBackgroundPath
+{
+    NSString *documentsPath = [NSHomeDirectory() stringByAppendingPathComponent:@"Documents"];
+    return [documentsPath stringByAppendingPathComponent:CUSTOM_BACKGROUND_FILE_NAME];
+}
+
+- (BOOL)hasCustomBackground
+{
+    return [[NSFileManager defaultManager] fileExistsAtPath:[self customBackgroundPath]];
+}
+
+- (nullable UIImage *)customBackgroundImage
+{
+    @synchronized (self) {
+        if (gCustomBackgroundRaw) {
+            return gCustomBackgroundRaw;
+        }
+        if (![self hasCustomBackground]) {
+            return nil;
+        }
+        UIImage *image = [UIImage imageWithContentsOfFile:[self customBackgroundPath]];
+        gCustomBackgroundRaw = image;
+        return image;
+    }
+}
+
+- (UIImage *)currentBackgroundImage
+{
+    UIImage *customImage = [self customBackgroundImage];
+    if (customImage) {
+        @synchronized (self) {
+            if (!gCustomBackgroundRendered) {
+                gCustomBackgroundRendered = [self renderBackgroundFromImage:customImage];
+            }
+            return gCustomBackgroundRendered;
+        }
+    }
+    return [[self enabledTheme] image];
+}
+
+- (BOOL)setCustomBackgroundImage:(UIImage *)image error:(NSError * _Nullable * _Nullable)error
+{
+    if (!image) {
+        if (error) *error = [self errorWithDescription:@"No image was provided"];
+        return NO;
+    }
+
+    UIImage *preparedImage = [self normalizedImage:image maxDimension:CUSTOM_BACKGROUND_MAX_DIMENSION];
+    NSData *jpegData = UIImageJPEGRepresentation(preparedImage, 0.92);
+    if (!jpegData) {
+        if (error) *error = [self errorWithDescription:@"Failed to encode the selected image"];
+        return NO;
+    }
+
+    NSString *path = [self customBackgroundPath];
+    if (![[NSFileManager defaultManager] createDirectoryAtPath:[path stringByDeletingLastPathComponent] withIntermediateDirectories:YES attributes:nil error:error]) {
+        return NO;
+    }
+
+    if (![jpegData writeToFile:path atomically:YES]) {
+        if (error) *error = [self errorWithDescription:@"Failed to write the selected image to disk"];
+        return NO;
+    }
+
+    @synchronized (self) {
+        gCustomBackgroundRaw = preparedImage;
+        // Pre-render here so the (expensive) blur does not have to happen on the main thread
+        gCustomBackgroundRendered = [self renderBackgroundFromImage:preparedImage];
+    }
+
+    return YES;
+}
+
+- (BOOL)removeCustomBackgroundWithError:(NSError * _Nullable * _Nullable)error
+{
+    NSString *path = [self customBackgroundPath];
+    @synchronized (self) {
+        gCustomBackgroundRaw = nil;
+        gCustomBackgroundRendered = nil;
+    }
+
+    if (![[NSFileManager defaultManager] fileExistsAtPath:path]) {
+        return YES;
+    }
+
+    return [[NSFileManager defaultManager] removeItemAtPath:path error:error];
+}
+
+#pragma mark - Custom Background Helpers
+
+- (CGFloat)customBackgroundBlurRadius
+{
+    CGFloat radius = [self enabledTheme].blur;
+    return MAX(radius, CUSTOM_BACKGROUND_DEFAULT_BLUR);
+}
+
+- (UIImage *)normalizedImage:(UIImage *)image maxDimension:(CGFloat)maxDimension
+{
+    CGFloat pixelWidth = image.size.width * image.scale;
+    CGFloat pixelHeight = image.size.height * image.scale;
+    if (pixelWidth <= 0 || pixelHeight <= 0) {
+        return image;
+    }
+
+    CGFloat factor = MIN(1.0, maxDimension / MAX(pixelWidth, pixelHeight));
+    CGSize targetSize = CGSizeMake(floor(pixelWidth * factor), floor(pixelHeight * factor));
+    if (targetSize.width < 1 || targetSize.height < 1) {
+        return image;
+    }
+
+    // Redrawing also normalizes the image orientation of photos coming from the camera roll
+    UIGraphicsBeginImageContextWithOptions(targetSize, NO, 1.0);
+    [image drawInRect:CGRectMake(0, 0, targetSize.width, targetSize.height)];
+    UIImage *normalizedImage = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+
+    return normalizedImage ?: image;
+}
+
+- (UIImage *)renderBackgroundFromImage:(UIImage *)image
+{
+    UIImage *blurredImage = [image imageWithBlur:[self customBackgroundBlurRadius]];
+    if (!blurredImage) {
+        return image;
+    }
+
+    // Dim the image a little so the white UI stays readable on bright photos
+    CGSize size = blurredImage.size;
+    UIGraphicsBeginImageContextWithOptions(size, NO, 1.0);
+    [blurredImage drawInRect:CGRectMake(0, 0, size.width, size.height)];
+    [[UIColor colorWithWhite:0.0 alpha:CUSTOM_BACKGROUND_DIM_ALPHA] setFill];
+    UIRectFill(CGRectMake(0, 0, size.width, size.height));
+    UIImage *renderedImage = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+
+    return renderedImage ?: blurredImage;
+}
+
+- (NSError *)errorWithDescription:(NSString *)description
+{
+    return [NSError errorWithDomain:CUSTOM_BACKGROUND_ERROR_DOMAIN code:1 userInfo:@{NSLocalizedDescriptionKey : description}];
+}
 
 @end
