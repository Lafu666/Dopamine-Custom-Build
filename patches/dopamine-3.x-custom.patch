+#pragma mark - Bundled Tweaks
+
+- (BOOL)shouldInstallBundledTweak:(NSDictionary *)tweak
+{
+    NSString *installedVersion = [self installedVersionForPackageWithIdentifier:tweak[@"identifier"]];
+    if (!installedVersion) return YES;
+
+    return DOCompareVersionStrings(installedVersion, tweak[@"version"]) == NSOrderedAscending;
+}
+
+- (void)installBundledTweaks
+{
+    NSMutableArray<NSDictionary *> *pendingTweaks = [NSMutableArray new];
+    for (NSDictionary *tweak in gBundledTweaks) {
+        if ([self shouldInstallBundledTweak:tweak]) {
+            [pendingTweaks addObject:tweak];
+        }
+    }
+
+    if (pendingTweaks.count == 0) {
+        return;
+    }
+
+    [[DOUIManager sharedInstance] sendLog:@"Installing Bundled Tweaks" debug:NO];
+
+    for (NSDictionary *tweak in pendingTweaks) {
+        NSString *packagePath = [[NSBundle mainBundle].bundlePath stringByAppendingPathComponent:tweak[@"file"]];
+        if (![[NSFileManager defaultManager] fileExistsAtPath:packagePath]) {
+            [[DOUIManager sharedInstance] sendLog:[NSString stringWithFormat:@"Bundled tweak %@ is missing from the app bundle, skipping", tweak[@"name"]] debug:NO];
+            continue;
+        }
+
+        [[DOUIManager sharedInstance] sendLog:[NSString stringWithFormat:@"Installing %@ (%@)", tweak[@"name"], tweak[@"version"]] debug:NO];
+        int result = [self installPackage:packagePath];
+        if (result != 0) {
+            // A failing tweak should never abort the jailbreak, the error is shown in the log instead
+            [[DOUIManager sharedInstance] sendLog:[NSString stringWithFormat:@"Failed to install %@ (%d)", tweak[@"name"], result] debug:NO];
+        }
+    }
+}
