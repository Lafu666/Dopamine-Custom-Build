+- (void)updateSubtitleAtIndex:(NSUInteger)index withString:(NSString *)string
+{
+    // Guard the index: this is called from a repeating timer
+    if (index >= self.subtitleLabels.count || !string) {
+        return;
+    }
+
+    UILabel *label = self.subtitleLabels[index];
+    NSAttributedString *template = label.attributedText;
+    if (!template) {
+        label.text = string;
+        return;
+    }
+
+    label.attributedText = [[NSAttributedString alloc] initWithString:string attributes:[template attributesAtIndex:0 effectiveRange:NULL]];
+}
